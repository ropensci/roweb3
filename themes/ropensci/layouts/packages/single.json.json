{{- /* The packages of a packages page, for the search box: name, maintainer, title, description and keywords, without accents. */ -}}
{{- $entries := slice -}}
{{- range $package := partial "packages/for-page.html" . -}}
  {{- $entries = $entries | append (dict
    "name" $package.Package
    "maintainer" (partial "accents/remove" ($package.Maintainer | replaceRE " <.*" ""))
    "description" $package.Title
    "details" (partial "accents/remove" $package.Description)
    "keywords" (partial "accents/remove" (delimit (default $package._topics (slice "")) ","))
  ) -}}
{{- end -}}
{{- $entries | jsonify -}}
